---
import "../styles/global.css"

interface Props {
  title?: string
  description?: string
}

const {
  title = "leo.dev",
  description = "Leo — Developer. Building and cooking the future.",
} = Astro.props
---

<!doctype html>
<html lang="en" class="bg-background">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#100815" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="scanlines">
    <div class="fixed inset-0 -z-10 bg-grid"></div>
    <div
      class="fixed inset-x-0 top-0 -z-10 h-[60vh]"
      style="background: radial-gradient(60% 60% at 50% 0%, oklch(0.68 0.2 300 / 0.15), transparent 70%);"
    >
    </div>
    <slot />
  </body>
</html>
