---
// LazyVim-style status line fixed to the bottom of the viewport.
---

<div
  class="fixed bottom-0 left-0 right-0 z-40 flex items-center justify-between border-t border-border/60 bg-surface/80 px-3 py-1 font-mono text-[10px] uppercase tracking-widest backdrop-blur sm:text-xs"
>
  <div class="flex items-center gap-2">
    <span class="rounded-sm bg-[var(--color-neon-pink)] px-2 py-0.5 font-bold text-background">
      NORMAL
    </span>
  <span class="hidden text-muted sm:inline">~/home/leo/portfolio.tsx</span>
  </div>
  <div class="flex items-center gap-3 text-muted">
    <span class="hidden text-[var(--color-neon-cyan)] sm:inline">main*</span>
    <span>utf-8</span>
    <span class="hidden sm:inline">tsx</span>
    <span class="text-[var(--color-neon-yellow)]">100%</span>
    <span>ln 1:1</span>
  </div>
</div>
